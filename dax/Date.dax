// Modeling > New table. This is a calculated table, not a measure.
// Whole years include a prior year and future promises; the source snapshot stays fixed.
Date =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2023, 1, 1 ), DATE ( 2026, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Month Number", MONTH ( [Date] ),
    "Month", FORMAT ( [Date], "MMM", "en-US" ),
    "Year Month", FORMAT ( [Date], "yyyy-MM" ),
    "Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
)
